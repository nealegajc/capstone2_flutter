# Smart Shelf 6-Camera Persistent Udev Rules
# Supports SunplusIT Inc Web Camera (5843:d527) & Jieli USB Cameras (5258:4a55)
# Mapped deterministically by physical USB Hub Port hierarchy across 2 USB Hubs

# ==============================================================================
# 1. Disable snd-usb-audio driver for all camera audio endpoints (Interface 2 & 3)
# Prevents USB isochronous bandwidth saturation and "Not enough bandwidth" kernel errors.
# ==============================================================================
# SunplusIT Cameras (5843:d527)
SUBSYSTEM=="usb", ATTRS{idVendor}=="5843", ATTRS{idProduct}=="d527", ENV{ID_USB_INTERFACE_NUM}=="02", RUN+="/bin/sh -c 'echo -n $kernel > /sys/bus/usb/drivers/snd-usb-audio/unbind 2>/dev/null || true'"
SUBSYSTEM=="usb", ATTRS{idVendor}=="5843", ATTRS{idProduct}=="d527", ENV{ID_USB_INTERFACE_NUM}=="03", RUN+="/bin/sh -c 'echo -n $kernel > /sys/bus/usb/drivers/snd-usb-audio/unbind 2>/dev/null || true'"

# Jieli Technology Cameras (5258:4a55)
SUBSYSTEM=="usb", ATTRS{idVendor}=="5258", ATTRS{idProduct}=="4a55", ENV{ID_USB_INTERFACE_NUM}=="02", RUN+="/bin/sh -c 'echo -n $kernel > /sys/bus/usb/drivers/snd-usb-audio/unbind 2>/dev/null || true'"
SUBSYSTEM=="usb", ATTRS{idVendor}=="5258", ATTRS{idProduct}=="4a55", ENV{ID_USB_INTERFACE_NUM}=="03", RUN+="/bin/sh -c 'echo -n $kernel > /sys/bus/usb/drivers/snd-usb-audio/unbind 2>/dev/null || true'"

# ==============================================================================
# 2. Physical Port to Camera Symlink Mappings (6 Cameras: 3 on Hub 1, 3 on Hub 2)
# ==============================================================================

# Hub 1 (USB Port 1-1 or 1-3) - Left Side of Shelf
SUBSYSTEM=="video4linux", KERNELS=="1-1.1:1.0", ATTR{index}=="0", SYMLINK+="cam1a v4l/by-name/cam1a"
SUBSYSTEM=="video4linux", KERNELS=="1-3.1:1.0", ATTR{index}=="0", SYMLINK+="cam1a v4l/by-name/cam1a"

SUBSYSTEM=="video4linux", KERNELS=="1-1.2:1.0", ATTR{index}=="0", SYMLINK+="cam2a v4l/by-name/cam2a"
SUBSYSTEM=="video4linux", KERNELS=="1-3.2:1.0", ATTR{index}=="0", SYMLINK+="cam2a v4l/by-name/cam2a"

SUBSYSTEM=="video4linux", KERNELS=="1-1.3:1.0", ATTR{index}=="0", SYMLINK+="cam3a v4l/by-name/cam3a"
SUBSYSTEM=="video4linux", KERNELS=="1-3.3:1.0", ATTR{index}=="0", SYMLINK+="cam3a v4l/by-name/cam3a"


# Hub 2 (USB Port 1-2 or 1-4) - Right Side of Shelf
SUBSYSTEM=="video4linux", KERNELS=="1-2.1:1.0", ATTR{index}=="0", SYMLINK+="cam1b v4l/by-name/cam1b"
SUBSYSTEM=="video4linux", KERNELS=="1-4.1:1.0", ATTR{index}=="0", SYMLINK+="cam1b v4l/by-name/cam1b"

SUBSYSTEM=="video4linux", KERNELS=="1-2.2:1.0", ATTR{index}=="0", SYMLINK+="cam2b v4l/by-name/cam2b"
SUBSYSTEM=="video4linux", KERNELS=="1-4.2:1.0", ATTR{index}=="0", SYMLINK+="cam2b v4l/by-name/cam2b"

SUBSYSTEM=="video4linux", KERNELS=="1-2.3:1.0", ATTR{index}=="0", SYMLINK+="cam3b v4l/by-name/cam3b"
SUBSYSTEM=="video4linux", KERNELS=="1-4.3:1.0", ATTR{index}=="0", SYMLINK+="cam3b v4l/by-name/cam3b"

# Legacy / daisy-chain fallbacks
SUBSYSTEM=="video4linux", KERNELS=="1-1.4:1.0", ATTR{index}=="0", SYMLINK+="cam2a_alt v4l/by-name/cam2a_alt"
SUBSYSTEM=="video4linux", KERNELS=="1-1.2.1:1.0", ATTR{index}=="0", SYMLINK+="cam1b_alt v4l/by-name/cam1b_alt"
SUBSYSTEM=="video4linux", KERNELS=="1-1.2.2:1.0", ATTR{index}=="0", SYMLINK+="cam2b_alt v4l/by-name/cam2b_alt"
SUBSYSTEM=="video4linux", KERNELS=="1-1.2.3:1.0", ATTR{index}=="0", SYMLINK+="cam3a_alt v4l/by-name/cam3a_alt"
SUBSYSTEM=="video4linux", KERNELS=="1-1.2.4:1.0", ATTR{index}=="0", SYMLINK+="cam3b_alt v4l/by-name/cam3b_alt"
