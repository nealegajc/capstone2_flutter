rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile authentication
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Master products catalog
    match /products/{productId} {
      allow read, write: if request.auth != null;
    }

    // Shelf ROI regions and configuration
    match /shelf_regions/{regionId} {
      allow read, write: if request.auth != null;
    }

    // Current branch inventory records
    match /inventory_records/{recordId} {
      allow read, write: if request.auth != null;
    }

    // Stock movement and audit events
    match /inventory_events/{eventId} {
      allow read, write: if request.auth != null;
    }

    // Detection events from YOLOv8
    match /detection_events/{detectionId} {
      allow read, write: if request.auth != null;
    }

    // OCR recognition results
    match /ocr_results/{ocrId} {
      allow read, write: if request.auth != null;
    }

    // Image quality and camera assessment logs
    match /image_quality_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    // Offline synchronization queue
    match /sync_queue/{queueId} {
      allow read, write: if request.auth != null;
    }

    // Inter-branch restock requests
    match /restock_records/{recordId} {
      allow read, write: if request.auth != null;
    }

    // System alerts and warnings
    match /alerts/{alertId} {
      allow read, write: if request.auth != null;
    }

    // System activity and security logs
    match /system_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    // System settings and global configuration
    match /settings/{settingId} {
      allow read, write: if request.auth != null;
    }

    // Fallback rule for authenticated access
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
